{
  "name": "dsh-org-talent",
  "version": "1.13.0",
  "description": "Organization-wide employee matching in the DSH left sidebar: a project guide with searchable progress, outcome summaries, recent projects and alerts; one-paste feedback parsed locally; a desktop memo per project; a requirement pool; one DSH conversation per project; a talent pool with create/delete employees and CSV/XLSX import; an org chart; team matching; capability advice; skill research. · 左侧栏的组织人才匹配：可检索的项目进度、成果摘要、近期项目与预警；粘贴反馈本地智能拆分；按项目保存的桌面备忘录；需求池；按项目创建的 DSH 对话工作区；人才库支持新建/删除员工与 CSV/XLSX 导入；以及组织架构、团队匹配与能力培养建议。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagicMOl/dsh-org-talent.git"
  },
  "homepage": "https://github.com/MagicMOl/dsh-org-talent#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "talent",
    "organization",
    "team-matching",
    "skills",
    "training",
    "workbench",
    "hr"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "PUBLISHING.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}

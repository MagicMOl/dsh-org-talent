{
  "name": "dsh-org-talent",
  "version": "1.3.0",
  "description": "Organization-wide employee matching in the DSH left sidebar: one workbench for every employee and their current skills, an org chart, team recommendations scored from organization-wide candidates, a capability plan for gaps and single points, and a skill-center training planner. Import CSV, TSV, JSON, Markdown or XLSX. · 左侧栏的组织人才匹配：员工技能工作台、组织架构、全组织团队匹配、缺口培养建议与技能中心培养计划，支持多种文件导入。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagicMOl/dsh-org-talent.git"
  },
  "homepage": "https://github.com/MagicMOl/dsh-org-talent#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "talent",
    "organization",
    "team-matching",
    "skills",
    "training",
    "workbench",
    "hr"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "PUBLISHING.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
